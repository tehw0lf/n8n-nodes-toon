{
	"name": "@tehw0lf/n8n-nodes-toon",
	"version": "1.3.3",
	"description": "n8n node for TOON (Token-Oriented Object Notation) format conversion - bidirectional conversion between TOON and JSON with zero external dependencies",
	"toonSpecVersion": "3.3.2",
	"license": "MIT",
	"homepage": "https://github.com/tehw0lf/n8n-nodes-toon#readme",
	"keywords": [
		"n8n-community-node-package",
		"toon",
		"json",
		"data-transformation",
		"format-conversion",
		"serialization",
		"llm",
		"token-optimization"
	],
	"author": {
		"name": "tehw0lf",
		"email": "tehwolf@protonmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tehw0lf/n8n-nodes-toon.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "npx @n8n/node-cli@latest lint",
		"lint:fix": "npx @n8n/node-cli@latest lint --fix",
		"test": "jest"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/Toon/Toon.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.40.2",
		"@types/jest": "30.0.0",
		"eslint": "9.29.0",
		"jest": "30.4.2",
		"prettier": "3.9.6",
		"ts-jest": "29.4.11",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
